# Copie para .env apenas para teste local com `npx netlify dev`.
# No Netlify, cadastre os mesmos valores em Environment variables.

# Segurança das Functions internas
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ACHILLES_ORG_ID=
INTERNAL_AUTH_DISABLED=false

# Google Places API (captação)
GOOGLE_PLACES_API_KEY=

# Claude API (opcional)
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (opcional/futuro)
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
