# Copie para .env apenas para teste local com `npx netlify dev`.
# No Netlify, cadastre os mesmos valores em Environment variables.
#
# Marcações:
#   [ativo]   o código já lê esta variável
#   [futuro]  prevista para a próxima etapa; ver docs/GUIA_IMPLEMENTACAO.md

# --- Segurança das Functions internas ------------------------------- [ativo]
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ACHILLES_ORG_ID=
INTERNAL_AUTH_DISABLED=false

# --- Google Places API (captação) ----------------------------------- [ativo]
GOOGLE_PLACES_API_KEY=

# --- Claude API ------------------------------------------------------ [ativo]
# IDs válidos: claude-opus-5, claude-sonnet-5, claude-haiku-4-5.
# Não acrescente sufixo de data ao ID.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Claude por tarefa ---------------------------------------------- [futuro]
# Abordagem e assistente pedem qualidade; triagem é volume e aceita modelo
# menor. Enquanto não existirem no código, tudo usa AI_MODEL acima.
ACHILLES_MODEL_OUTREACH=claude-opus-5
ACHILLES_MODEL_ASSISTANT=claude-opus-5
ACHILLES_MODEL_TRIAGE=claude-haiku-4-5

# --- WhatsApp Cloud API: envio --------------------------------------- [ativo]
# whatsapp-send.mjs já existe e respeita este interruptor.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Confira a versão vigente na documentação da Meta antes de fixar.
WHATSAPP_API_VERSION=v23.0

# --- WhatsApp Cloud API: recebimento -------------------------------- [futuro]
# Para whatsapp-webhook.mjs, que ainda precisa ser construído.
# WHATSAPP_APP_SECRET valida a assinatura X-Hub-Signature-256: sem ele,
# qualquer um que descobrir a URL pode injetar conversa falsa no CRM.
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
