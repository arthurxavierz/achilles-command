{
  "manifest_version": 3,
  "name": "Achilles Prospecta",
  "version": "1.6.1",
  "description": "Fila de abordagem do Achilles Command dentro do WhatsApp Web, com estúdio de roteiros: variáveis, variações, anexos e teste A/B com placar de respostas.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app.achillesmedia.com.br/*",
    "https://*.achillesmedia.com.br/*",
    "https://*.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Achilles Prospecta",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.achillesmedia.com.br/*",
        "https://*.achillesmedia.com.br/*",
        "https://*.netlify.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/roteiros.js",
        "lib/ui.js",
        "content-command.js"
      ],
      "css": [
        "content-command.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/roteiros.js",
        "lib/ui.js",
        "content-whatsapp.js"
      ],
      "css": [
        "content-whatsapp.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "studio.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/ui.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://app.achillesmedia.com.br/*",
        "https://*.achillesmedia.com.br/*",
        "https://*.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}